---
import Layout from '../layouts/Layout.astro';

const achievements = [
  {
    id: 'netacad-riders',
    title: 'Gold Medal (Top 5 Percent)',
    event: 'Cisco APJC NetAcad Riders 2026',
    details: 'Ranked 4th in Malaysia for advanced networking and security automation.',
    tone: 'gold',
    clearance: 'TOP-5%',
    icon: 'shield',
    certImage: 'cisco-netacad-2026.jpg',
  },
  {
    id: 'idpex-iot',
    title: 'Gold Award',
    event: 'IDPEX',
    details:
      'Won out of more than 20 entries for building a Smart Home Garbage Monitoring IoT solution.',
    tone: 'gold',
    clearance: 'GOLD SIG',
    icon: 'microchip',
    certImage: 'idpex-gold.jpg',
  },
  {
    id: 'ereka-sql',
    title: 'Gold Award',
    event: 'EREKA',
    details: 'Won among 30 project participants for designing a secure Lost and Found SQL Database System.',
    tone: 'gold',
    clearance: 'SECURE DB',
    icon: 'database',
    certImage: 'ereka-gold.jpg',
  },
  {
    id: 'neraca-ctf',
    title: '6th Place Nationally',
    event: 'NERACA 3.0 CTF',
    details:
      'Competed out of 32 teams using advanced cryptography and protocol exploitation strategies.',
    tone: 'neon',
    clearance: 'FLAGGED',
    icon: 'flag',
    certImage: 'neraca-3.0-ctf.jpg',
  },
  {
    id: 'uitm-quest',
    title: '8th Place National Finalist',
    event: 'UiTM Cyber Quest CTF',
    details: 'Solved complex technical challenges in Cryptography and Reverse Engineering.',
    tone: 'neon',
    clearance: 'KEY LOCK',
    icon: 'key',
    certImage: 'uitm-cyber-quest.jpg',
  },
  {
    id: 'iboh-2025',
    title: '26th Place Overall',
    event: 'International Battle of Hackers (IBOH) 2025',
    details: 'Competed against 42 international teams in incident response and web exploitation.',
    tone: 'neon',
    clearance: 'RADAR LOCK',
    icon: 'radar',
    certImage: 'iboh-2025.jpg',
  },
] as const;

const base = import.meta.env.BASE_URL ?? '/';
---

<Layout title="Achievements and Awards | Amierul Faiz" description="Achievements, awards, and digital badge logs from competitions and events.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">

    <div class="mb-8 max-w-3xl sm:mb-10">
      <p class="text-xs uppercase tracking-[0.35em] text-cyan-400 sm:text-sm">Achievements and Awards</p>
      <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl md:text-5xl">Mission Success Logs</h1>
      <p class="mt-4 text-base leading-7 text-slate-300 sm:mt-5 sm:text-lg sm:leading-8">
        A living record of major milestones, verified achievements, and professional recognition.
      </p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 sm:gap-7 lg:grid-cols-3">
      {
        achievements.map((item) => {
          const isGold = item.tone === 'gold';
          const iconColor = isGold ? 'text-amber-400' : 'text-cyan-400';
          const iconGlow = isGold
            ? 'drop-shadow-[0_0_18px_rgba(251,191,36,0.6)]'
            : 'drop-shadow-[0_0_18px_rgba(34,211,238,0.6)]';
          const cardBorderHover = isGold
            ? 'hover:border-amber-400/60'
            : 'hover:border-cyan-400/60';
          const cardShadowClass = isGold ? 'card-glow-gold' : 'card-glow-cyan';

          return (
            <article
              class={`group relative flex min-h-0 flex-col rounded-2xl border border-zinc-800 bg-zinc-900/70 p-5 shadow-lg shadow-black/20 transition-all duration-300 sm:min-h-[280px] sm:p-8 hover:-translate-y-2 ${cardBorderHover} ${cardShadowClass}`}
            >
              <div class="relative flex flex-1 flex-col">
                <div class={`mb-4 inline-flex h-12 w-12 items-center justify-center rounded-xl border sm:mb-6 sm:h-14 sm:w-14 ${isGold ? 'border-amber-400/20 bg-amber-400/10' : 'border-cyan-400/20 bg-cyan-400/10'}`}>
                  {
                    item.icon === 'shield' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="M9 12l2 2 4-5" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'microchip' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="7" y="7" width="10" height="10" rx="2" />
                        <path d="M4 10h3M4 14h3M17 10h3M17 14h3M10 4v3M14 4v3M10 17v3M14 17v3" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'database' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <ellipse cx="12" cy="5" rx="8" ry="3" />
                        <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
                        <path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'flag' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M4 22V4" />
                        <path d="M4 4h11l-1 3 3 2-3 2 1 3H4" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'key' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M21 10l-3-3" />
                        <path d="M7 14l-4 4" />
                        <path d="M15 7a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'radar' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 12l8-2" />
                        <path d="M12 12l-4 9" />
                        <path d="M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                        <path d="M2 12h4" />
                      </svg>
                    ) : null
                  }
                </div>

                <p class={`font-mono text-[11px] font-semibold uppercase tracking-[0.2em] ${isGold ? 'text-amber-400' : 'text-cyan-400'}`}>{item.title}</p>

                <h2
                  class="title-glitch mt-2 text-lg font-bold leading-snug text-white transition-colors group-hover:text-cyan-200 sm:text-xl"
                  data-text={item.event}
                >
                  {item.event}
                </h2>

                <p class="mt-4 text-sm leading-relaxed text-slate-400 transition-colors group-hover:text-slate-200">
                  {item.details}
                </p>

                <div class="mt-5 overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/40 aspect-video relative group-hover:border-zinc-700/60 transition cursor-pointer" data-cert-img-click={`${base}certificates/${item.certImage}`} data-cert-title={item.event}>
                  <img
                    src={`${base}certificates/${item.certImage}`}
                    alt={`${item.event} Preview`}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
                    <svg class="h-6 w-6 text-white drop-shadow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m4-3H6" />
                    </svg>
                  </div>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>

    <!-- Clean certificate modal structure -->
    <div
      id="cert-modal"
      class="fixed inset-0 z-50 hidden flex-items-center justify-center p-4"
      aria-modal="true"
      role="dialog"
    >
      <div class="fixed inset-0 bg-black/80 backdrop-blur-sm" id="modal-overlay"></div>
      <div class="relative z-10 w-full max-w-4xl overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950 p-3 shadow-2xl transition-transform duration-300 scale-95 opacity-0 sm:p-4" id="modal-container">
        <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
          <h3 class="font-mono text-sm font-semibold text-slate-100 sm:text-base" id="modal-title">Certificate</h3>
          <button
            type="button"
            class="rounded-lg p-1.5 text-slate-400 transition hover:bg-zinc-800 hover:text-white"
            aria-label="Close modal"
            id="modal-close-btn"
          >
            <svg class="h-5 w-5 sm:h-6 sm:w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="mt-3 flex items-center justify-center bg-black/40 p-2 rounded-xl border border-zinc-900/60 max-h-[70vh] overflow-y-auto">
          <img
            src=""
            alt="Certificate View"
            class="max-h-[60vh] max-w-full rounded-lg object-contain shadow-lg"
            id="modal-image"
          />
        </div>
      </div>
    </div>

    <style is:global>
      .card-glow-gold {
        box-shadow: 0 0 0 rgba(251, 191, 36, 0);
        transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .card-glow-gold:hover {
        box-shadow:
          0 0 20px rgba(251, 191, 36, 0.15),
          0 0 40px rgba(251, 191, 36, 0.08),
          inset 0 1px 0 rgba(251, 191, 36, 0.1);
      }

      .card-glow-cyan {
        box-shadow: 0 0 0 rgba(34, 211, 238, 0);
        transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .card-glow-cyan:hover {
        box-shadow:
          0 0 20px rgba(34, 211, 238, 0.15),
          0 0 40px rgba(34, 211, 238, 0.08),
          inset 0 1px 0 rgba(34, 211, 238, 0.1);
      }

      .animate-scanlines::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          repeating-linear-gradient(
            to bottom,
            rgba(16, 185, 129, 0.14),
            rgba(16, 185, 129, 0.14) 1px,
            rgba(0, 0, 0, 0) 3px,
            rgba(0, 0, 0, 0) 6px
          );
        opacity: 0.25;
        animation: scan 7s linear infinite;
      }

      .animate-scanlines {
        position: relative;
      }

      @keyframes scan {
        0% { transform: translateY(-20px); }
        100% { transform: translateY(20px); }
      }

      .title-glitch {
        position: relative;
      }

      .title-glitch::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 0;
        right: 0;
        height: 100%;
        color: rgba(34, 211, 238, 0.95);
        text-shadow: 0 0 18px rgba(34, 211, 238, 0.35);
        opacity: 0;
        pointer-events: none;
      }

      .group:hover .title-glitch::after {
        animation: typing-glitch 520ms ease forwards;
      }

      .group:hover .title-glitch {
        animation: glitch-flicker 360ms steps(2, end) 1;
      }

      @keyframes typing-glitch {
        0% {
          opacity: 0;
          clip-path: inset(0 100% 0 0);
          filter: hue-rotate(0deg);
        }
        35% {
          opacity: 1;
          clip-path: inset(0 0 0 0);
          filter: hue-rotate(10deg);
        }
        60% {
          opacity: 1;
          clip-path: inset(20% 0 0 0);
        }
        100% {
          opacity: 0.2;
          clip-path: inset(0 0 0 0);
          filter: hue-rotate(0deg);
        }
      }

      @keyframes glitch-flicker {
        0% {
          text-shadow:
            -1px 0 rgba(251, 191, 36, 0.35),
            1px 0 rgba(16, 185, 129, 0.35);
          transform: translate(0, 0);
        }
        20% {
          text-shadow:
            -2px 0 rgba(34, 211, 238, 0.55),
            2px 0 rgba(34, 211, 238, 0.15);
          transform: translate(-1px, 0);
        }
        40% { transform: translate(1px, 0); }
        60% { transform: translate(0, 0); }
        100% {
          text-shadow: 0 0 0 rgba(0, 0, 0, 0);
          transform: translate(0, 0);
        }
      }
    </style>

    <script>
      const modal = document.getElementById('cert-modal');
      const modalContainer = document.getElementById('modal-container');
      const modalOverlay = document.getElementById('modal-overlay');
      const modalClose = document.getElementById('modal-close-btn');
      const modalTitle = document.getElementById('modal-title');
      const modalImage = document.getElementById('modal-image') as HTMLImageElement | null;
      const certElements = document.querySelectorAll('[data-cert-img-click]');

      const showModal = (src: string, title: string) => {
        if (!modal || !modalContainer || !modalTitle || !modalImage) return;
        modalImage.src = src;
        modalTitle.textContent = title;
        
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
          modalContainer.classList.remove('scale-95', 'opacity-0');
          modalContainer.classList.add('scale-100', 'opacity-100');
        }, 10);
      };

      const hideModal = () => {
        if (!modal || !modalContainer) return;
        modalContainer.classList.remove('scale-100', 'opacity-100');
        modalContainer.classList.add('scale-95', 'opacity-0');

        setTimeout(() => {
          modal.classList.remove('flex');
          modal.classList.add('hidden');
          document.body.style.overflow = '';
        }, 300);
      };

      certElements.forEach(el => {
        el.addEventListener('click', () => {
          const src = el.getAttribute('data-cert-img-click') || '';
          const title = el.getAttribute('data-cert-title') || 'Certificate';
          showModal(src, title);
        });
      });

      if (modalClose) modalClose.addEventListener('click', hideModal);
      if (modalOverlay) modalOverlay.addEventListener('click', hideModal);

      // close on escape key
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') hideModal();
      });
    </script>
  </section>
</Layout>
