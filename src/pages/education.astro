---
import Layout from '../layouts/Layout.astro';

const achievements = [
  {
    title: 'Gold Medal (Top 5 Percent)',
    event: 'Cisco APJC NetAcad Riders 2026',
    details: 'Ranked 4th in Malaysia for advanced networking and security automation.',
    tone: 'gold',
    clearance: 'TOP-5%',
    icon: 'shield',
  },
  {
    title: 'Gold Award',
    event: 'IDPEX',
    details:
      'Won out of more than 20 entries for building a Smart Home Garbage Monitoring IoT solution.',
    tone: 'gold',
    clearance: 'GOLD SIG',
    icon: 'microchip',
  },
  {
    title: 'Gold Award',
    event: 'EREKA',
    details: 'Won among 30 project participants for designing a secure Lost and Found SQL Database System.',
    tone: 'gold',
    clearance: 'SECURE DB',
    icon: 'database',
  },
  {
    title: '6th Place Nationally',
    event: 'NERACA 3.0 CTF',
    details:
      'Competed out of 32 teams using advanced cryptography and protocol exploitation strategies.',
    tone: 'neon',
    clearance: 'FLAGGED',
    icon: 'flag',
  },
  {
    title: '8th Place National Finalist',
    event: 'UiTM Cyber Quest CTF',
    details: 'Solved complex technical challenges in Cryptography and Reverse Engineering.',
    tone: 'neon',
    clearance: 'KEY LOCK',
    icon: 'key',
  },
  {
    title: '26th Place Overall',
    event: 'International Battle of Hackers (IBOH) 2025',
    details: 'Competed against 42 international teams in incident response and web exploitation.',
    tone: 'neon',
    clearance: 'RADAR LOCK',
    icon: 'radar',
  },
] as const;
---

<Layout title="Achievements and Awards | Amierul Faiz" description="Achievements, awards, and digital badge logs from competitions and events.">
  <section class="relative overflow-hidden mx-auto max-w-6xl px-6 py-20 lg:px-8">
    {/* Matrix / digital grid background */}
    <div class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(34,211,238,0.12),_transparent_45%)]" />
      <div
        class="absolute inset-0 opacity-[0.30] [background-image:linear-gradient(to_right,rgba(34,211,238,0.10)_1px,transparent_1px),linear-gradient(to_bottom,rgba(34,211,238,0.08)_1px,transparent_1px)] [background-size:64px_64px]"
      />
      <div class="absolute inset-0 opacity-20 bg-[linear-gradient(to_bottom,rgba(16,185,129,0.12),transparent)]" />
      <div class="absolute inset-0 opacity-30 mix-blend-screen animate-scanlines" />
    </div>

    <div class="mb-10 max-w-3xl">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Achievements and Awards</p>
      <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">Mission Success Logs</h1>
      <p class="mt-5 text-lg leading-8 text-slate-300">
        Verified results and cyber victories—rendered like a terminal-grade mission report.
      </p>
    </div>

    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        achievements.map((item) => {
          const isGold = item.tone === 'gold';
          const iconColor = isGold ? 'text-amber-400' : 'text-cyan-400';
          const iconGlow = isGold
            ? 'drop-shadow-[0_0_18px_rgba(251,191,36,0.6)]'
            : 'drop-shadow-[0_0_18px_rgba(34,211,238,0.6)]';
          const cardBorderHover = isGold
            ? 'hover:border-amber-400/60'
            : 'hover:border-cyan-400/60';
          const cardShadowClass = isGold ? 'card-glow-gold' : 'card-glow-cyan';

          return (
            <article
              class={`group relative flex min-h-[280px] flex-col rounded-2xl border border-slate-800 bg-slate-900/60 p-8 backdrop-blur-md transition-all duration-300 hover:-translate-y-2 ${cardBorderHover} ${cardShadowClass}`}
            >
              <div class="relative flex flex-1 flex-col">
                <div class={`mb-6 inline-flex h-14 w-14 items-center justify-center rounded-xl border ${isGold ? 'border-amber-400/20 bg-amber-400/10' : 'border-cyan-400/20 bg-cyan-400/10'}`}>
                  {
                    item.icon === 'shield' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="M9 12l2 2 4-5" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'microchip' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="7" y="7" width="10" height="10" rx="2" />
                        <path d="M4 10h3M4 14h3M17 10h3M17 14h3M10 4v3M14 4v3M10 17v3M14 17v3" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'database' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <ellipse cx="12" cy="5" rx="8" ry="3" />
                        <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
                        <path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'flag' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M4 22V4" />
                        <path d="M4 4h11l-1 3 3 2-3 2 1 3H4" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'key' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M21 10l-3-3" />
                        <path d="M7 14l-4 4" />
                        <path d="M15 7a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" />
                      </svg>
                    ) : null
                  }
                  {
                    item.icon === 'radar' ? (
                      <svg
                        class={`h-7 w-7 ${iconColor} ${iconGlow}`}
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 12l8-2" />
                        <path d="M12 12l-4 9" />
                        <path d="M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                        <path d="M2 12h4" />
                      </svg>
                    ) : null
                  }
                </div>

                <p class={`font-mono text-[11px] font-semibold uppercase tracking-[0.2em] ${isGold ? 'text-amber-400' : 'text-cyan-400'}`}>{item.title}</p>

                <h2
                  class="title-glitch mt-2 text-xl font-bold leading-snug text-white transition-colors group-hover:text-cyan-200"
                  data-text={item.event}
                >
                  {item.event}
                </h2>

                <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-400 transition-colors group-hover:text-slate-200">
                  {item.details}
                </p>

                <div
                  class={`mt-6 h-px w-full rounded bg-gradient-to-r ${isGold ? 'from-amber-400/0 via-amber-400/30 to-amber-400/0' : 'from-cyan-400/0 via-cyan-400/30 to-cyan-400/0'}`}
                  aria-hidden="true"
                />
              </div>
            </article>
          );
        })
      }
    </div>

    <style is:global>
      .card-glow-gold {
        box-shadow: 0 0 0 rgba(251, 191, 36, 0);
        transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .card-glow-gold:hover {
        box-shadow:
          0 0 20px rgba(251, 191, 36, 0.15),
          0 0 40px rgba(251, 191, 36, 0.08),
          inset 0 1px 0 rgba(251, 191, 36, 0.1);
      }

      .card-glow-cyan {
        box-shadow: 0 0 0 rgba(34, 211, 238, 0);
        transition: box-shadow 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
      }
      .card-glow-cyan:hover {
        box-shadow:
          0 0 20px rgba(34, 211, 238, 0.15),
          0 0 40px rgba(34, 211, 238, 0.08),
          inset 0 1px 0 rgba(34, 211, 238, 0.1);
      }

      .animate-scanlines::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          repeating-linear-gradient(
            to bottom,
            rgba(16, 185, 129, 0.14),
            rgba(16, 185, 129, 0.14) 1px,
            rgba(0, 0, 0, 0) 3px,
            rgba(0, 0, 0, 0) 6px
          );
        opacity: 0.25;
        animation: scan 7s linear infinite;
      }

      .animate-scanlines {
        position: relative;
      }

      @keyframes scan {
        0% { transform: translateY(-20px); }
        100% { transform: translateY(20px); }
      }

      .title-glitch {
        position: relative;
        overflow: hidden;
      }

      .title-glitch::after {
        content: attr(data-text);
        position: absolute;
        left: 0;
        top: 0;
        width: 0;
        white-space: nowrap;
        color: rgba(34, 211, 238, 0.95);
        text-shadow: 0 0 18px rgba(34, 211, 238, 0.35);
        overflow: hidden;
      }

      .group:hover .title-glitch::after {
        animation: typing-glitch 520ms steps(24, end) forwards;
      }

      .group:hover .title-glitch {
        animation: glitch-flicker 360ms steps(2, end) 1;
      }

      @keyframes typing-glitch {
        0% {
          width: 0;
          clip-path: inset(0 100% 0 0);
          filter: hue-rotate(0deg);
        }
        35% {
          width: 110%;
          clip-path: inset(0 0 0 0);
          filter: hue-rotate(10deg);
        }
        60% {
          width: 92%;
          clip-path: inset(20% 0 0 0);
        }
        100% {
          width: 100%;
          clip-path: inset(0 0 0 0);
          filter: hue-rotate(0deg);
        }
      }

      @keyframes glitch-flicker {
        0% {
          text-shadow:
            -1px 0 rgba(251, 191, 36, 0.35),
            1px 0 rgba(16, 185, 129, 0.35);
          transform: translate(0, 0);
        }
        20% {
          text-shadow:
            -2px 0 rgba(34, 211, 238, 0.55),
            2px 0 rgba(34, 211, 238, 0.15);
          transform: translate(-1px, 0);
        }
        40% { transform: translate(1px, 0); }
        60% { transform: translate(0, 0); }
        100% {
          text-shadow: 0 0 0 rgba(0, 0, 0, 0);
          transform: translate(0, 0);
        }
      }
    </style>
  </section>
</Layout>

