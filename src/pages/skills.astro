---
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
---

<Layout title="Skills | Amierul Faiz" description="Technical skills, tools, certifications, and programming knowledge.">
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Skills</p>
      <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">Tools, Certifications & Programming</h1>
      <p class="mt-5 text-lg leading-8 text-slate-300">
        A practical mix of security, engineering, and development capabilities—organized for quick scanning.
      </p>
    </div>

    <Skills />
  </section>
</Layout>

