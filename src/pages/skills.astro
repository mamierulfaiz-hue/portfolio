---
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
---

<Layout title="Skills | Amierul Faiz" description="Technical skills, tools, certifications, and programming knowledge.">
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
    <div class="mb-8 max-w-3xl sm:mb-10">
      <p class="text-xs uppercase tracking-[0.35em] text-cyan-400 sm:text-sm">Skills</p>
      <h1 class="mt-3 text-3xl font-semibold text-white sm:text-4xl md:text-5xl">Tools, Certifications &amp; Programming</h1>
      <p class="mt-4 text-base leading-7 text-slate-300 sm:mt-5 sm:text-lg sm:leading-8">
        A clear view of the tools I use, the systems I secure, and how my technical skills support my goal in cybersecurity.
      </p>
    </div>

    <Skills />
  </section>
</Layout>

