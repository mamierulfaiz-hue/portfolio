---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact | Amierul Faiz" description="Let us connect. Open to discussing SOC, penetration testing, and network security opportunities.">
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Secure Comms</p>
      <h1 class="mt-3 text-4xl font-semibold text-white sm:text-5xl">Contact Me</h1>
      <p class="mt-5 text-lg leading-8 text-slate-300">
        Let us connect. I am open to discussing SOC, penetration testing, and network security opportunities.
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
      <article class="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-7 shadow-xl shadow-black/20">
        <div class="flex items-center justify-between gap-4 border-b border-zinc-800 pb-4">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">Direct Contact</p>
            <h2 class="mt-2 font-mono text-lg font-semibold text-white">System Data Panel</h2>
          </div>
          <div class="rounded-full border border-cyan-300/30 bg-zinc-950/60 px-3 py-2">
            <p class="font-mono text-xs text-cyan-200/80">ONLINE</p>
          </div>
        </div>

        <div class="mt-6 space-y-4">
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/40 p-4">
            <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">Email</p>
            <a
              href="mailto:m.amierulfaiz@gmail.com"
              class="mt-2 block font-mono text-sm text-emerald-300 hover:text-emerald-200 transition"
            >
              m.amierulfaiz@gmail.com
            </a>
          </div>

          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/40 p-4">
            <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">GitHub</p>
            <a
              href="https://github.com/mamierulfaiz-hue"
              target="_blank"
              rel="noreferrer"

              class="mt-2 block font-mono text-sm text-emerald-300 hover:text-emerald-200 transition"
            >
              github.com/mamierulfaiz-hue
            </a>
          </div>

          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/40 p-4">
            <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">LinkedIn</p>
            <a
              href="https://linkedin.com/in/amierulfaiz"
              target="_blank"
              rel="noreferrer"
              class="mt-2 block font-mono text-sm text-emerald-300 hover:text-emerald-200 transition"
            >
              linkedin.com/in/amierulfaiz
            </a>
          </div>

        </div>
      </article>

      <article class="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-7 shadow-xl shadow-black/20">
        <div class="flex items-center justify-between gap-4 border-b border-zinc-800 pb-4">
          <div>
            <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">Secure Message</p>
            <h2 class="mt-2 font-mono text-lg font-semibold text-white">Encrypt and Send</h2>
          </div>
          <div class="text-xs font-mono text-cyan-200/70">TLS-ready</div>
        </div>

        <div class="mt-6 space-y-5">
          <div>
            <label class="block text-xs font-mono uppercase tracking-widest text-cyan-300" for="name">Name</label>
            <input
              id="name"
              type="text"
              readOnly
              aria-readonly="true"
              tabIndex={-1}
              class="mt-2 w-full rounded-2xl border border-zinc-800 bg-black/20 px-4 py-3 font-mono text-sm text-slate-100 placeholder:text-slate-500 outline-none transition"
            />
          </div>

          <div>
            <label class="block text-xs font-mono uppercase tracking-widest text-cyan-300" for="email">Email</label>
            <input
              id="email"
              type="email"
              readOnly
              aria-readonly="true"
              tabIndex={-1}
              class="mt-2 w-full rounded-2xl border border-zinc-800 bg-black/20 px-4 py-3 font-mono text-sm text-slate-100 placeholder:text-slate-500 outline-none transition"
            />
          </div>

          <div>
            <label class="block text-xs font-mono uppercase tracking-widest text-cyan-300" for="message">Message</label>
            <textarea
              id="message"
              readOnly
              aria-readonly="true"
              tabIndex={-1}
              rows="5"
              class="mt-2 w-full resize-none rounded-2xl border border-zinc-800 bg-black/20 px-4 py-3 font-mono text-sm text-slate-100 placeholder:text-slate-500 outline-none transition"
            />
          </div>

          <div class="pt-1">
            <button
              type="button"
              disabled
              aria-disabled="true"
              class="w-full cursor-not-allowed rounded-2xl bg-emerald-300/10 px-5 py-3 text-sm font-semibold text-emerald-200 opacity-90 border border-emerald-300/40"
            >
              Secure Channel Active
            </button>
          </div>

          <div class="text-xs text-slate-400">
            Auto-typing demo (display-only). No form submission is performed.
          </div>
        </div>

        <script>
          const parts = [
            { el: 'name', value: 'Recruiter' },
            { el: 'email', value: 'recruiter@company.com' },
            {
              el: 'message',
              value:
                'Hello Amierul. I reviewed your portfolio and I am very impressed with your SOC and Threat Detection skills. I would like to connect.',
            },
          ];

          const blinkCaret = (container) => {
            const caret = document.createElement('span');
            caret.textContent = '▌';
            caret.className = 'ml-1 inline-block animate-pulse text-emerald-300';
            container.appendChild(caret);
            return caret;
          };

          const run = async () => {
            const nameEl = document.getElementById('name');
            const emailEl = document.getElementById('email');
            const msgEl = document.getElementById('message');
            if (!nameEl || !emailEl || !msgEl) return;

            const caretHost = nameEl.parentElement;
            const caret = blinkCaret(caretHost);

            const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
            const typeInto = async (inputEl, text) => {
              inputEl.value = '';
              for (let i = 0; i < text.length; i++) {
                inputEl.value += text[i];
                await sleep(18);
              }
            };

            // loop forever
            while (true) {
              for (const part of parts) {
                const target = document.getElementById(part.el);
                if (!target) continue;
                await typeInto(target, part.value);
                await sleep(500);
              }

              await sleep(2500);

              // clear
              nameEl.value = '';
              emailEl.value = '';
              msgEl.value = '';

              await sleep(600);
            }
          };

          run();
        </script>

        <style is:global>
          input:focus,
          textarea:focus {
            outline: none;
          }
        </style>

      </article>
    </div>
  </section>
</Layout>

