---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL ?? '/';
---

<Layout>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-36">
    <div class="grid items-center gap-10 sm:gap-12 lg:grid-cols-2 lg:gap-16">
      <div class="max-w-xl">
        <p class="text-xs uppercase tracking-[0.35em] text-cyan-400 sm:text-sm">Cybersecurity Portfolio</p>
        <h1 class="mt-4 text-3xl font-semibold leading-tight text-white sm:mt-6 sm:text-5xl lg:text-6xl">
          Muhammad Amierul Faiz Bin Ibrahim
        </h1>
        <p class="mt-4 text-base leading-7 text-slate-300 sm:mt-6 sm:text-xl sm:leading-8">
          Aspiring Cybersecurity Engineer (SOC and Penetration Testing)
        </p>
        <p class="mt-2 text-sm text-slate-400 sm:mt-3">
          Terengganu, Malaysia
        </p>
        <div class="mt-8 flex flex-wrap gap-3 sm:mt-10 sm:gap-4">
          <a href={`${base}projects`} class="rounded-full bg-cyan-500 px-5 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-cyan-400 sm:px-6 sm:py-3">
            Explore Projects
          </a>
          <a href={`${base}skills`} class="rounded-full border border-zinc-700 px-5 py-2.5 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300 sm:px-6 sm:py-3">
            View Skills
          </a>
        </div>
      </div>

      <div class="rounded-2xl border border-zinc-800 bg-zinc-900/70 shadow-2xl shadow-black/30 sm:rounded-3xl">
        <div class="flex items-center justify-between rounded-t-2xl border-b border-zinc-800/80 bg-zinc-950/60 px-4 py-3 sm:rounded-t-3xl sm:px-5 sm:py-3.5">
          <div class="flex items-center gap-2">
            <span class="h-3 w-3 rounded-full bg-red-500/80 sm:h-3.5 sm:w-3.5" />
            <span class="h-3 w-3 rounded-full bg-yellow-500/80 sm:h-3.5 sm:w-3.5" />
            <span class="h-3 w-3 rounded-full bg-green-500/80 sm:h-3.5 sm:w-3.5" />
          </div>
          <div class="text-[10px] font-mono text-cyan-200/70 sm:text-xs">/root/security-daemon</div>
        </div>

        <div class="px-4 py-5 sm:px-6 sm:py-8">
          <div class="rounded-xl bg-black/30 p-3 sm:rounded-2xl sm:p-5">
            <pre class="m-0 whitespace-pre-wrap break-words font-mono text-xs leading-6 text-emerald-300 sm:text-sm sm:leading-7" aria-live="polite">
<span class="typed-terminal" data-commands='[
  "root@amierulfaiz:~$ ./initialize_security_protocols.sh",
  "> loading toolkit: [Splunk, Nessus, Wireshark, Kali Linux]... OK",
  "> establishing secure connection... DONE",
  "> system status: SECURE. Ready for operation."
]' data-interval="28"></span><span class="terminal-caret" aria-hidden="true">█</span>
            </pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8 lg:pb-28">
    <div class="rounded-xl bg-slate-900/50 px-5 py-8 sm:rounded-2xl sm:px-12 sm:py-14">
      <div class="flex flex-col gap-5 sm:gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <p class="text-[10px] font-mono uppercase tracking-widest text-cyan-400 sm:text-xs">Featured Project</p>
          <h2 class="mt-2 text-xl font-semibold text-white sm:mt-3 sm:text-2xl md:text-3xl">Cisco APJC NetAcad Riders 2026</h2>
          <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-300 sm:mt-3 sm:text-base sm:leading-7">
            Gold Medal (Top 5%) — Ranked 4th in Malaysia for advanced networking and security automation across the Asia-Pacific region.
          </p>
        </div>
        <a href={`${base}projects`} class="inline-flex shrink-0 items-center gap-2 rounded-full border border-zinc-700 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300">
          View All Projects
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <style is:global>
    .terminal-caret {
      display: inline-block;
      margin-left: 2px;
      color: #34d399;
      animation: terminalBlink 0.9s step-end infinite;
    }

    @keyframes terminalBlink {
      0%, 50% { opacity: 1; }
      50.01%, 100% { opacity: 0; }
    }
  </style>

  <script>
    (function () {
      const el = document.querySelector('.typed-terminal');
      if (!el) return;

      const commands = JSON.parse(el.getAttribute('data-commands') || '[]');
      const interval = Number(el.getAttribute('data-interval') || '28');
      el.textContent = '';

      let cmdIndex = 0;
      let charIndex = 0;
      let current = commands[cmdIndex] || '';
      let isErasing = false;

      const typeNext = () => {
        if (!commands.length) return;

        if (!isErasing) {
          charIndex++;
          el.textContent = current.slice(0, charIndex);

          if (charIndex >= current.length) {
            setTimeout(() => {
              isErasing = true;
              typeNext();
            }, 650);
          } else {
            setTimeout(typeNext, interval);
          }
        } else {
          charIndex--;
          el.textContent = current.slice(0, Math.max(0, charIndex));

          if (charIndex <= 0) {
            isErasing = false;
            cmdIndex = (cmdIndex + 1) % commands.length;
            current = commands[cmdIndex] || '';
            charIndex = 0;
            setTimeout(typeNext, 120);
          } else {
            setTimeout(typeNext, Math.max(10, interval - 10));
          }
        }
      };

      setTimeout(typeNext, 220);
    })();
  </script>
</Layout>
