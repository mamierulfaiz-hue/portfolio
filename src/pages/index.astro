---
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
const base = import.meta.env.BASE_URL ?? '/';
---

<Layout>
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Developer Portfolio</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl lg:text-6xl">
          I build practical solutions at the intersection of IoT efficiency and web development.
        </h1>
        <p class="mt-6 text-lg leading-8 text-slate-300">
          I’m Amierul Faiz, a developer focused on creating reliable systems, smart automation,
          and polished digital experiences that make everyday processes simpler.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={`${base}projects`} class="rounded-full bg-cyan-500 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-cyan-400">
            Explore Projects
          </a>
          <a href={`${base}#skills`} class="rounded-full border border-zinc-700 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300">
            View Skills
          </a>
        </div>
      </div>

      <div class="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-8 shadow-2xl shadow-black/30">
        <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Current Focus</p>
        <div class="mt-6 space-y-4 text-sm leading-7 text-slate-300">
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/70 p-4">
            <h2 class="font-semibold text-white">Smart Automation</h2>
            <p class="mt-2">Designing connected systems that improve operational efficiency and reduce manual effort.</p>
          </div>
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/70 p-4">
            <h2 class="font-semibold text-white">Modern Web Experiences</h2>
            <p class="mt-2">Building clean, responsive web apps with maintainable architecture and thoughtful UI.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="mx-auto max-w-6xl px-6 py-8 lg:px-8">
    <div class="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-8 shadow-xl shadow-black/20">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">About</p>
      <h2 class="mt-3 text-3xl font-semibold text-white">I enjoy turning ideas into efficient, real-world solutions.</h2>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
        My work blends hardware awareness, automation thinking, and web development to create systems that feel intuitive and useful.
      </p>
    </div>
  </section>

  <section id="skills" class="mx-auto max-w-6xl px-6 py-16 lg:px-8">
    <div class="mb-8">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Skills</p>
      <h2 class="mt-3 text-3xl font-semibold text-white">A practical mix of software, hardware, and vision expertise.</h2>
    </div>
    <Skills />
  </section>

  <section id="contact" class="mx-auto max-w-6xl px-6 pb-20 lg:px-8">
    <div class="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-8 shadow-xl shadow-black/20">
      <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Contact</p>
      <h2 class="mt-3 text-3xl font-semibold text-white">Let’s build something useful together.</h2>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">
        Reach out for collaboration, freelance work, or ideas around IoT systems and modern web apps.
      </p>
      <a href="mailto:m.amierulfaiz@gmail.com" class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-cyan-200">
        Contact Me
      </a>

      <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <a
          href="https://www.linkedin.com/in/amierulfaiz"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center rounded-full border border-zinc-800 bg-zinc-950/30 px-4 py-2 text-slate-200 transition hover:border-cyan-400 hover:text-cyan-300"
        >
          LinkedIn
        </a>
        <a
          href="https://github.com/mamierulfaiz-hue"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center rounded-full border border-zinc-800 bg-zinc-950/30 px-4 py-2 text-slate-200 transition hover:border-cyan-400 hover:text-cyan-300"
        >
          GitHub
        </a>
      </div>

    </div>
  </section>
</Layout>
