---
import Layout from '../layouts/Layout.astro';
import Skills from '../components/Skills.astro';
const base = import.meta.env.BASE_URL ?? '/';
---

<Layout>
  <section class="mx-auto max-w-6xl px-6 py-20 lg:px-8 lg:py-28">
    <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="max-w-3xl">
        <p class="text-sm uppercase tracking-[0.35em] text-cyan-400">Cybersecurity Portfolio</p>
        <h1 class="mt-4 text-3xl font-semibold leading-tight text-white sm:text-4xl lg:text-5xl">
          Muhammad Amierul Faiz Bin Ibrahim
        </h1>
        <p class="mt-4 text-lg leading-8 text-slate-300 sm:text-xl">
          Aspiring Cybersecurity Engineer (SOC and Penetration Testing)
        </p>
        <p class="mt-2 text-sm text-slate-400">
          Location: Terengganu, Malaysia
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={`${base}projects`} class="rounded-full bg-cyan-500 px-5 py-3 text-sm font-semibold text-zinc-950 transition hover:bg-cyan-400">
            Explore Projects
          </a>
          <a href={`${base}#skills`} class="rounded-full border border-zinc-700 px-5 py-3 text-sm font-semibold text-slate-100 transition hover:border-cyan-400 hover:text-cyan-300">
            View Skills
          </a>
        </div>
      </div>

      <div class="rounded-3xl border border-zinc-800 bg-zinc-900/70 p-8 shadow-2xl shadow-black/30">
        <p class="text-sm uppercase tracking-[0.3em] text-slate-400">Current Focus</p>
        <div class="mt-6 space-y-4 text-sm leading-7 text-slate-300">
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/70 p-4">
            <h2 class="font-semibold text-white">Vulnerability Research</h2>
            <p class="mt-2">Actively hunting and patching system weaknesses before they can be exploited.</p>
          </div>
          <div class="rounded-2xl border border-zinc-800 bg-zinc-950/70 p-4">
            <h2 class="font-semibold text-white">Threat Detection</h2>
            <p class="mt-2">Monitoring network environments and analyzing traffic to secure critical data.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-20 lg:px-8">
    <div class="grid gap-6 lg:grid-cols-[1.25fr_0.75fr] lg:items-start">
      <div class="rounded-3xl border border-zinc-800 bg-zinc-900/70 shadow-xl shadow-black/20">
        <div class="flex items-center justify-between rounded-t-3xl border-b border-zinc-800/80 bg-zinc-950/60 px-4 py-3">
          <div class="flex items-center gap-2">
            <span class="h-3.5 w-3.5 rounded-full bg-red-500/80" />
            <span class="h-3.5 w-3.5 rounded-full bg-yellow-500/80" />
            <span class="h-3.5 w-3.5 rounded-full bg-green-500/80" />
          </div>
          <div class="text-xs font-mono text-cyan-200/70">/root/security-daemon</div>
        </div>

        <div class="px-5 py-6">
          <div class="rounded-2xl bg-black/30 p-4">
            <pre class="m-0 whitespace-pre-wrap break-words font-mono text-sm leading-6 text-emerald-300" aria-live="polite">
<span class="typed-terminal" data-commands='[
  "root@amierulfaiz:~$ ./initialize_security_protocols.sh",
  "> loading toolkit: [Splunk, Nessus, Wireshark, Kali Linux]... OK",
  "> establishing secure connection... DONE",
  "> system status: SECURE. Ready for operation."
]' data-interval="28"></span><span class="terminal-caret" aria-hidden="true">█</span>
            </pre>
          </div>
        </div>
      </div>

      <div class="space-y-5">
        <div
          class="relative group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/60 p-6 shadow-lg shadow-black/20 transition-all duration-300 hover:border-cyan-400/60"
        >
          <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <div class="absolute -left-10 top-0 h-full w-[90px] -skew-x-12 bg-gradient-to-r from-cyan-400/0 via-cyan-400/40 to-cyan-400/0 blur-[2px] animate-laser" />
          </div>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">Status</p>
              <h3 class="mt-2 font-mono text-lg font-semibold text-white">GOLD MEDAL (Top 5%)</h3>
            </div>
            <div class="rounded-full border border-cyan-300/30 bg-zinc-950/60 px-3 py-2">
              <p class="text-xs font-mono text-cyan-200/80">CLEARANCE</p>
            </div>
          </div>
          <p class="mt-4 text-sm text-slate-300">
            <span class="font-semibold text-slate-200">Mission:</span> Cisco APJC NetAcad Riders 2026
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Ranked 4th in Malaysia for advanced networking and security automation.
          </p>
        </div>

        <div
          class="relative group overflow-hidden rounded-3xl border border-zinc-800 bg-zinc-900/60 p-6 shadow-lg shadow-black/20 transition-all duration-300 hover:border-cyan-400/60"
        >
          <div class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            <div class="absolute -left-10 top-0 h-full w-[90px] -skew-x-12 bg-gradient-to-r from-cyan-400/0 via-cyan-400/40 to-cyan-400/0 blur-[2px] animate-laser" />
          </div>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-mono uppercase tracking-widest text-cyan-300">Status</p>
              <h3 class="mt-2 font-mono text-lg font-semibold text-white">6TH PLACE NATIONALLY</h3>
            </div>
            <div class="rounded-full border border-cyan-300/30 bg-zinc-950/60 px-3 py-2">
              <p class="text-xs font-mono text-cyan-200/80">MISSION LOG</p>
            </div>
          </div>
          <p class="mt-4 text-sm text-slate-300">
            <span class="font-semibold text-slate-200">Mission:</span> NERACA 3.0 CTF
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-300">
            Competed against 32 teams applying advanced cryptography and protocol exploitation.
          </p>
        </div>
      </div>
    </div>

    <style is:global>
      .terminal-caret {
        display: inline-block;
        margin-left: 2px;
        color: #34d399;
        animation: terminalBlink 0.9s step-end infinite;
      }

      @keyframes terminalBlink {
        0%, 50% { opacity: 1; }
        50.01%, 100% { opacity: 0; }
      }

      @keyframes laser {
        0% { transform: translateX(-40px); opacity: 0; }
        20% { opacity: 1; }
        100% { transform: translateX(280px); opacity: 0; }
      }

      .animate-laser {
        animation: laser 1.1s ease-in-out infinite;
      }
    </style>

    <script>
      (function () {
        const el = document.querySelector('.typed-terminal');
        if (!el) return;

        const commands = JSON.parse(el.getAttribute('data-commands') || '[]');
        const interval = Number(el.getAttribute('data-interval') || '28');
        el.textContent = '';

        const caret = document.querySelector('.terminal-caret');

        let cmdIndex = 0;
        let charIndex = 0;
        let current = commands[cmdIndex] || '';
        let isErasing = false;

        const typeNext = () => {
          if (!commands.length) return;

          if (!isErasing) {
            charIndex++;
            el.textContent = current.slice(0, charIndex);

            if (charIndex >= current.length) {
              // pause at end then move to next
              setTimeout(() => {
                isErasing = true;
                typeNext();
              }, 650);
            } else {
              setTimeout(typeNext, interval);
            }
          } else {
            charIndex--;
            el.textContent = current.slice(0, Math.max(0, charIndex));

            if (charIndex <= 0) {
              isErasing = false;
              cmdIndex = (cmdIndex + 1) % commands.length;
              current = commands[cmdIndex] || '';
              charIndex = 0;
              setTimeout(typeNext, 120);
            } else {
              setTimeout(typeNext, Math.max(10, interval - 10));
            }
          }
        };

        setTimeout(typeNext, 220);
      })();
    </script>
  </section>
</Layout>

