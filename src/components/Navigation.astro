---
const base = import.meta.env.BASE_URL ?? '/';
const links = [
  { label: 'Home', href: '' },
  { label: 'About', href: 'about' },
  { label: 'Skills', href: 'skills' },
  { label: 'Achievements', href: 'education' },
  { label: 'Projects', href: 'projects' },
  { label: 'Contact', href: 'contact' },
];
---

<nav class="sticky top-0 z-20 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-8">
    <a href={base} class="text-lg font-semibold tracking-wide text-slate-100 transition hover:text-cyan-400">
      Amierul Faiz
    </a>

    <div class="flex flex-wrap items-center gap-3 text-sm text-slate-300">
      {links.map((link) => (
        <a
          href={`${base}${link.href}`}
          class="rounded-full px-3 py-2 transition hover:bg-zinc-800 hover:text-white"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>
