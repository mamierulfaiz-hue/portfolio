---
import {
  siSplunk, siKalilinux, siWireshark, siCisco, siMetasploit, siBurpsuite, siTailscale,
  siLaravel, siPhp, siHtml5, siCss, siTailwindcss, siBootstrap, siJavascript, siNodedotjs,
  siMysql, siFirebase,
  siPython, siOpenjdk, siCplusplus, siGnubash,
  siRaspberrypi, siArduino, siEspressif,
  siOpencv,
  siUbuntu, siDocker, siGit, siGithub,
  siGooglegemini, siGithubcopilot,
} from 'simple-icons';

type BrandIcon = { svg: string; hex: string };

const brandIcons: Record<string, BrandIcon> = {
  splunk: siSplunk,
  kali: siKalilinux,
  wireshark: siWireshark,
  packettracer: siCisco,
  metasploit: siMetasploit,
  burp: siBurpsuite,
  tailscale: siTailscale,
  laravel: siLaravel,
  php: siPhp,
  html: siHtml5,
  css: siCss,
  tailwind: siTailwindcss,
  bootstrap: siBootstrap,
  javascript: siJavascript,
  node: siNodedotjs,
  mysql: siMysql,
  firebase: siFirebase,
  python: siPython,
  java: siOpenjdk,
  cpp: siCplusplus,
  bash: siGnubash,
  raspberrypi: siRaspberrypi,
  arduino: siArduino,
  esp8266: siEspressif,
  opencv: siOpencv,
  ubuntu: siUbuntu,
  docker: siDocker,
  git: siGit,
  github: siGithub,
  gemini: siGooglegemini,
  copilot: siGithubcopilot,
};

const colorOverrides: Record<string, string> = {
  splunk: '#F58220',
  java: '#ED8B00',
  github: '#ffffff',
  copilot: '#ffffff',
  tailscale: '#ffffff',
};

function getIconSvg(key: string): string {
  const brand = brandIcons[key];
  if (brand) {
    const color = colorOverrides[key] || `#${brand.hex}`;
    return brand.svg
      .replace('<svg ', `<svg class="h-5 w-5" fill="${color}" `)
      .replace('role="img" ', '');
  }
  return fallbackIcons[key] || fallbackIcons['default'];
}

