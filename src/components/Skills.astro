const skillGroups = [
  {
    title: 'Cybersecurity and Networking',
    items: [
      { name: 'Splunk (SIEM)', icon: 'splunk' },
      { name: 'Nessus (Vulnerability Scanning)', icon: 'nessus' },
      { name: 'Kali Linux', icon: 'kali' },
