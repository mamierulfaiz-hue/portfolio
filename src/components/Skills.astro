          <path d="M12 2 22 7v10l-10 5L2 17V7l10-5Z" fill="currentColor" opacity="0.2" />
          <path d="M8.2 12.2 12 8.4l3.8 3.8L12 16l-3.8-3.8Z" fill="currentColor" />
          <path d="M12 8.4v7.6" opacity="0.7" />
        </svg>
      );

    default:
      return (
        <svg {...common}>
          <path d="M12 2l9 5v10l-9 5-9-5V7l9-5Z" />
          <path d="M8 12h8" />
        </svg>
      );
  }
};

const Card = ({ icon, label }) => (
  <div class="group rounded-2xl border border-zinc-800 bg-zinc-900/60 p-4 shadow-lg shadow-black/20 transition-all duration-300 hover:border-cyan-400/50 hover:bg-zinc-900/75">
    <div class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-xl border border-cyan-300/20 bg-cyan-500/10 text-cyan-200">
        <Icon name={icon} />
      </div>
      <div class="min-w-0">
        <div class="truncate text-sm font-semibold text-slate-100 group-hover:text-cyan-200">
          {label}
        </div>
      </div>
    </div>
  </div>
);
---

<div class="space-y-10">
  {skillGroups.map((group) => (
    <section class="space-y-5" aria-label={group.title}>
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-xl font-semibold text-white">{group.title}</h2>
        <div class="h-px flex-1 rounded bg-gradient-to-r from-cyan-400/0 via-cyan-400/30 to-cyan-400/0" aria-hidden="true" />
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {group.items.map((it) => (
          <Card icon={it.icon} label={it.name} />
        ))}
      </div>
    </section>
  ))}
</div>

