const getIconSvg = (key: string) => iconSvgByKey[key] ?? iconSvgByKey['splunk'];
---

<div class="space-y-10">
  {skillGroups.map((group) => (
    <section class="space-y-5" aria-label={group.title}>
      <div class="flex items-center justify-between gap-4">
        <h2 class="text-xl font-semibold text-white">{group.title}</h2>
        <div
          class="h-px flex-1 rounded bg-gradient-to-r from-cyan-400/0 via-cyan-400/30 to-cyan-400/0"
          aria-hidden="true"
        />
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {group.items.map((it) => (
          <div
            class="group flex items-center gap-3 rounded-2xl border border-zinc-800 bg-zinc-900/60 p-4 shadow-lg shadow-black/20 transition-all duration-300 hover:border-cyan-400/50 hover:bg-zinc-900/75"
          >
            <div
              class="flex h-10 w-10 items-center justify-center rounded-xl border border-cyan-300/20 bg-cyan-500/10 text-cyan-200"
              aria-hidden="true"
            >
              <Fragment set:html={getIconSvg(it.icon)} />
            </div>
            <div class="min-w-0">
              <div class="truncate text-sm font-semibold text-slate-100 group-hover:text-cyan-200">
                {it.name}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

